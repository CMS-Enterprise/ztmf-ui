# Environment configuration for local development
# Copy this file to .env.development.local and fill in the values
#
# IMPORTANT: These settings are ONLY for local development (yarn dev)
# They do NOT affect AWS dev/prod deployments (yarn build:dev / yarn build:prod)

# Backend API proxy configuration
# Default: http://localhost:3000 (matches makefile dev setup in backend repo)
VITE_CF_DOMAIN=http://localhost:3000

# The local auth-bypass bearer token is NOT an env var: it lives in
# public/config.js (gitignored), read by the app at runtime. Generate it with
# `make frontend-env` from the backend repo, or write the file by hand:
#   window.ZTMF_RUNTIME_CONFIG = { authToken: '<jwt>' }

# Disable identity provider for local development
# Set to 'false' for local dev, 'true' for AWS environments
VITE_IDP_ENABLED=false

# Development banner overrides (all optional; leave empty to use built-in copy)
# The banner shows in every non-production environment regardless of these.
# Set these locally only to preview testing-window copy; real values for the
# deployed dev environment are injected from CI secrets, never committed.
VITE_DEV_BANNER_MESSAGE=
VITE_DEV_FEEDBACK_URL=
VITE_DEV_CONTACT_EMAIL=

# Legacy proxy configuration (leave empty for default setup)
TOKEN=
PROXY_URI=