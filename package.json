{
  "name": "ztmf-ui",
  "private": true,
  "version": "0.0.0-semantic-release",
  "license": "UNLICENSED",
  "description": "CMS ZTMF UI Application",
  "homepage": "https://github.com/CMS-Enterprise/ztmf-ui",
  "bugs": {
    "url": "https://github.com/CMS-Enterprise/ztmf-ui/issues"
  },
  "author": "Noblis & Aquia, Inc.",
  "contributors": [
    "Alex Tran",
    "Sinan Bolel"
  ],
  "type": "module",
  "packageManager": "yarn@4.4.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": "please-use-yarn",
    "yarn": "4.4.0"
  },
  "scripts": {
    "start": "yarn run dev",
    "dev": "vite",
    "build:prod": "tsc -p tsconfig.prod.json && vite build --mode production",
    "build:dev": "tsc -p tsconfig.prod.json && vite build --mode development",
    "build:impl": "tsc -p tsconfig.prod.json && vite build --mode impl",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "test": "NODE_ENV=test jest --coverage --colors --maxWorkers=50%",
    "test:precommit": "NODE_ENV=test jest --onlyChanged --coverage --colors --watch=false --maxWorkers=50%",
    "test:watch": "NODE_ENV=test jest --onlyChanged --coverage --colors --watch --maxWorkers=25%",
    "test:ci": "NODE_ENV=test jest --ci --all  --coverage --colors --maxWorkers=100%",
    "typecheck": "tsc --noEmit",
    "ci": "run-p 'lint:js' 'lint:other' 'test:ci'",
    "pre-push": "run-s typecheck lint",
    "lint": "run-p 'lint:js' 'lint:other'",
    "lint:js": "eslint ./ --cache --cache-location ./node_modules/.cache/eslint --color --report-unused-disable-directives",
    "lint:other": "prettier --check '**/*.{json,md,yaml,yml}' --ignore-path .gitignore --ignore-path .prettierignore",
    "fix": "run-p 'fix:**'",
    "fix:js": "yarn run lint:js --fix",
    "fix:other": "yarn run lint:other --write",
    "semantic-release": "semantic-release",
    "postinstall": "yarn run prepare",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.16.2",
    "@mui/x-data-grid": "^6.19.4",
    "@mui/x-date-pickers": "^6.20.2",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "core-js": "^3.37.1",
    "lodash": "^4.17.23",
    "notistack": "^3.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@babel/core": "^7.29.7",
    "@cmsgov/design-system": "^13.2.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@swc/core": "^1.7.6",
    "@swc/jest": "^0.2.36",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.14.14",
    "@types/prop-types": "^15.7.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "axios-mock-adapter": "^2.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^14.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.70.0",
    "semantic-release": "^23.0.2",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.58.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.4.3",
    "vite-plugin-environment": "^1.1.3",
    "web-vitals": "^3.5.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.html": [
      "prettier --parser html --write"
    ],
    "**/*.{js,jsx,ts,tsx,cjs}": [
      "prettier --write",
      "eslint --fix --cache --cache-location ./node_modules/.cache/eslint --color"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "restricted"
  },
  "release": {
    "private": true,
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "dist",
              "label": "Distribution"
            },
            {
              "path": "CHANGELOG.md",
              "label": "Changelog"
            },
            {
              "path": "README.md",
              "label": "Readme"
            }
          ]
        }
      ]
    ],
    "preset": "conventionalcommits"
  },
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "form-data@^3.0.0": "^3.0.4",
    "form-data@^4.0.0": "^4.0.4",
    "handlebars": "^4.7.9",
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3",
    "minimatch": "^3.1.5",
    "immutable": "^4.3.9",
    "lodash": "~4.18.1",
    "defu": "^6.1.7",
    "lodash-es": "^4.18.0",
    "tar": "^7.5.21",
    "brace-expansion": "^1.1.18",
    "@tootallnate/once": "^3.0.1",
    "follow-redirects": "^1.16.0",
    "ws": "^8.21.0",
    "@babel/core": "^7.29.6",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "ip": "^2.0.1",
    "glob@^10.2.2": "^10.5.0",
    "glob@^10.3.10": "^10.5.0",
    "glob@^10.3.7": "^10.5.0",
    "js-yaml@^3.13.1": "^3.15.1",
    "js-yaml@^4.1.0": "^4.3.1",
    "js-yaml@^4.1.1": "^4.3.1"
  }
}
